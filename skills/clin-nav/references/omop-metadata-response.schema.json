{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mtchuang1981/clin-data-nav/schemas/omop-metadata-response.schema.json",
  "title": "ClinNav redacted OMOP metadata connector responses",
  "oneOf": [
    {
      "$ref": "#/$defs/capabilities"
    },
    {
      "$ref": "#/$defs/inspectionSummary"
    }
  ],
  "$defs": {
    "contractVersion": {
      "type": "string",
      "enum": ["1.0", "1.1"],
      "maxLength": 8
    },
    "semanticVersion": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+(?:[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "omopVersion": {
      "type": "string",
      "maxLength": 16,
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "publicToken": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "canonicalName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "typeFamily": {
      "type": "string",
      "enum": [
        "binary",
        "boolean",
        "date",
        "datetime",
        "decimal",
        "integer",
        "string"
      ],
      "maxLength": 16
    },
    "allowlistSupport": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowlist_id",
        "allowlist_version"
      ],
      "properties": {
        "allowlist_id": {
          "$ref": "#/$defs/publicToken"
        },
        "allowlist_version": {
          "$ref": "#/$defs/semanticVersion"
        }
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "adapter_id",
        "adapter_version",
        "metadata_read_only",
        "row_access",
        "sql_execution",
        "raw_schema_export",
        "supported_omop_cdm_versions",
        "supported_allowlists",
        "max_snapshot_age_seconds",
        "tbls_inspection_available",
        "max_response_bytes"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "adapter_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "adapter_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "metadata_read_only": {
          "const": true
        },
        "row_access": {
          "const": false
        },
        "sql_execution": {
          "const": false
        },
        "raw_schema_export": {
          "const": false
        },
        "supported_omop_cdm_versions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/omopVersion"
          }
        },
        "supported_allowlists": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/allowlistSupport"
          }
        },
        "max_snapshot_age_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 31536000
        },
        "tbls_inspection_available": {
          "const": true
        },
        "max_response_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 262144
        }
      }
    },
    "typeMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_column_name",
        "expected_type_family",
        "observed_type_family"
      ],
      "properties": {
        "canonical_column_name": {
          "$ref": "#/$defs/canonicalName"
        },
        "expected_type_family": {
          "$ref": "#/$defs/typeFamily"
        },
        "observed_type_family": {
          "$ref": "#/$defs/typeFamily"
        }
      }
    },
    "nullabilityMismatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_column_name",
        "expected_nullable",
        "observed_nullable"
      ],
      "properties": {
        "canonical_column_name": {
          "$ref": "#/$defs/canonicalName"
        },
        "expected_nullable": {
          "type": "boolean"
        },
        "observed_nullable": {
          "type": "boolean"
        }
      }
    },
    "tableResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canonical_table_name",
        "presence",
        "standard_column_total",
        "present_standard_columns",
        "missing_standard_columns",
        "type_mismatches",
        "nullability_mismatches",
        "primary_key_status",
        "foreign_key_status",
        "unexpected_column_count"
      ],
      "properties": {
        "canonical_table_name": {
          "$ref": "#/$defs/canonicalName"
        },
        "presence": {
          "type": "string",
          "enum": [
            "missing",
            "present",
            "unknown"
          ],
          "maxLength": 16
        },
        "standard_column_total": {
          "type": "integer",
          "minimum": 0,
          "maximum": 178
        },
        "present_standard_columns": {
          "type": "array",
          "maxItems": 178,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonicalName"
          }
        },
        "missing_standard_columns": {
          "type": "array",
          "maxItems": 178,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/canonicalName"
          }
        },
        "type_mismatches": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/typeMismatch"
          }
        },
        "nullability_mismatches": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/nullabilityMismatch"
          }
        },
        "primary_key_status": {
          "type": "string",
          "enum": [
            "different",
            "matches",
            "missing",
            "unknown"
          ],
          "maxLength": 16
        },
        "foreign_key_status": {
          "type": "string",
          "enum": [
            "different",
            "matches",
            "missing",
            "unknown"
          ],
          "maxLength": 16
        },
        "unexpected_column_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        }
      }
    },
    "dqdForeignKeyEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "binding_kind", "snapshot_binding_sha256", "checked_at",
        "reference_sha256", "checked_fk_set_sha256",
        "expected_fk_check_count", "checked_fk_count", "failed_fk_count"
      ],
      "properties": {
        "binding_kind": {"type": "string", "enum": ["content-sha256", "immutable-snapshot-id", "size-mtime"], "maxLength": 32},
        "snapshot_binding_sha256": {"oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
        "checked_at": {"type": "string", "maxLength": 64, "format": "date-time"},
        "reference_sha256": {"$ref": "#/$defs/sha256"},
        "checked_fk_set_sha256": {"$ref": "#/$defs/sha256"},
        "expected_fk_check_count": {"type": "integer", "minimum": 0, "maximum": 178},
        "checked_fk_count": {"type": "integer", "minimum": 0, "maximum": 178},
        "failed_fk_count": {"type": "integer", "minimum": 0, "maximum": 178}
      }
    },
    "inspectionSummary": {
      "type": "object",
      "additionalProperties": false,
      "allOf": [{
        "if": {"properties": {"contract_version": {"const": "1.1"}}},
        "then": {"required": ["dqd_foreign_key_evidence", "snapshot_binding_sha256"]},
        "else": {"not": {"anyOf": [
          {"required": ["dqd_foreign_key_evidence"]},
          {"required": ["snapshot_binding_sha256"]}
        ]}}
      }],
      "required": [
        "contract_version",
        "adapter_version",
        "omop_cdm_version",
        "allowlist_id",
        "allowlist_version",
        "reference_sha256",
        "observed_at",
        "tbls_version",
        "scan_status",
        "summary_sha256",
        "unexpected_table_count",
        "unexpected_column_count",
        "limitation_codes",
        "tables"
      ],
      "properties": {
        "contract_version": {
          "$ref": "#/$defs/contractVersion"
        },
        "adapter_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "omop_cdm_version": {
          "$ref": "#/$defs/omopVersion"
        },
        "allowlist_id": {
          "$ref": "#/$defs/publicToken"
        },
        "allowlist_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "reference_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "observed_at": {
          "type": "string",
          "maxLength": 64,
          "format": "date-time"
        },
        "tbls_version": {
          "$ref": "#/$defs/semanticVersion"
        },
        "scan_status": {
          "type": "string",
          "enum": [
            "complete",
            "failed",
            "partial"
          ],
          "maxLength": 16
        },
        "summary_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "unexpected_table_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "unexpected_column_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "limitation_codes": {
          "type": "array",
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "enum": [
              "constraint-metadata-limited",
              "metadata-permission-limited",
              "snapshot-incomplete",
              "tbls-normalization-limited"
            ],
            "maxLength": 32
          }
        },
        "tables": {
          "type": "array",
          "minItems": 13,
          "maxItems": 13,
          "items": {
            "$ref": "#/$defs/tableResult"
          }
        },
        "dqd_foreign_key_evidence": {
          "oneOf": [{"$ref": "#/$defs/dqdForeignKeyEvidence"}, {"type": "null"}]
        },
        "snapshot_binding_sha256": {
          "oneOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]
        }
      }
    }
  }
}
